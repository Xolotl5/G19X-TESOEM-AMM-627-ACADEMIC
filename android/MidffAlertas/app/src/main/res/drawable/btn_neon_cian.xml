<?xml version="1.0" encoding="utf-8"?>
<!-- Botón cápsula de cristal con borde resplandeciente cian neón:
     halo exterior difuso + filo translúcido + núcleo ahumado -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26C9CED5" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#40C9CED5" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#E60D0E10" />
            <stroke
                android:width="1dp"
                android:color="#99C9CED5" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>