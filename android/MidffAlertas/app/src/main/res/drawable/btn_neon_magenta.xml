<?xml version="1.0" encoding="utf-8"?>
<!-- Botón cápsula de cristal con borde resplandeciente magenta neón
     (acción principal "Bloquear") -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33E000FF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#4DE000FF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#E6150A18" />
            <stroke
                android:width="1dp"
                android:color="#CCE000FF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>