<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo carbón profundo con auroras difusas azul-púrpura-rosa que se
     insinúan detrás de los paneles de cristal ahumado -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo_carbon" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.12"
                android:centerY="0.06"
                android:gradientRadius="440dp"
                android:startColor="#335E4B8A"
                android:endColor="#005E4B8A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.92"
                android:centerY="0.16"
                android:gradientRadius="420dp"
                android:startColor="#2ED4C2FF"
                android:endColor="#00D4C2FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.45"
                android:centerY="0.96"
                android:gradientRadius="520dp"
                android:startColor="#308A5CFF"
                android:endColor="#008A5CFF" />
        </shape>
    </item>
</layer-list>