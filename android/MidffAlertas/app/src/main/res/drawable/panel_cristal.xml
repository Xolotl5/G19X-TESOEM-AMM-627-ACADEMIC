<?xml version="1.0" encoding="utf-8"?>
<!-- Panel de cristal ahumado: relleno translúcido (~70%) con leve degradado
     vertical que sugiere volumen (sombreado interno), borde suave de 1px
     semitransparente y esquinas muy redondeadas (frosted glass) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#C823232C"
        android:centerColor="#B31E1E24"
        android:endColor="#99191B22"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/cristal_borde" />
    <corners android:radius="24dp" />
</shape>