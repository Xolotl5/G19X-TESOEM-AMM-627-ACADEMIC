<?xml version="1.0" encoding="utf-8"?>
<!-- Punto de estado de la isla dinámica: núcleo cian con halo difuso -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="oval">
            <solid android:color="#4DC9CED5" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/neon_cian" />
        </shape>
    </item>
</layer-list>