<?xml version="1.0" encoding="utf-8"?>
<!-- MIDFF: paleta "Noche Violeta" (BIT-034): negro profundo con tinte morado
     + morados armoniosos (protagonista #9F7BFF), mismo lenguaje visual de
     cristal ahumado con neones de contraste profundo -->
<resources>
    <!-- Fondo negro violáceo profundo (no negro total) -->
    <color name="fondo_carbon">#0A0812</color>
    <color name="fondo_carbon_claro">#150F22</color>

    <!-- Cristal ahumado morado: paneles translúcidos con borde lavanda -->
    <color name="cristal">#1B1429</color>
    <color name="cristal_70">#B31B1429</color>
    <color name="cristal_50">#801B1429</color>
    <color name="cristal_borde">#33B69CFF</color>
    <color name="cristal_borde_suave">#26B69CFF</color>

    <!-- Neones de contraste profundo (lavanda + morado protagonista) -->
    <color name="neon_cian">#C9B8FF</color>
    <color name="neon_magenta">#FFFFFF</color>
    <color name="neon_purpura">#9F7BFF</color>

    <!-- Aurora: degradados orgánicos índigo-morado-lavanda -->
    <color name="aurora_azul">#5E4B8A</color>
    <color name="aurora_purpura">#8A5CFF</color>
    <color name="aurora_rosa">#D4C2FF</color>

    <!-- Texto -->
    <color name="texto_titulo">#FFFFFF</color>
    <color name="texto_secundario">#AEA3C7</color>
    <color name="texto_fecha">#8F84AD</color>

    <!-- Mapeo del tema Material al lenguaje violeta nocturno -->
    <color name="midff_primario">#9F7BFF</color>
    <color name="midff_primario_oscuro">#150F22</color>
    <color name="midff_acento">#B69CFF</color>
    <color name="blanco">#FFFFFF</color>

    <!-- Bandas de riesgo (BIT-028): semántica rojo/amarillo/verde en tonos
         "dark material" desaturados que armonizan con el negro/morado de la
         estética (contrato: BAJO menor 0.4, MEDIO 0.4-0.7, ALTO mayor 0.7) -->
    <color name="clasificacion_bajo">#81C99B</color>
    <color name="clasificacion_medio">#FDD663</color>
    <color name="clasificacion_alto">#F28B82</color>
</resources>
