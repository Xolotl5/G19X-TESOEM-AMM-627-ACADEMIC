# =============================================================================
# MIDFF - Plantilla de variables de entorno (COPIAR a .env y llenar valores)
# Uso : copiar este archivo como ".env" en la raiz y completar cada valor.
#       servidor.ps1 y smoke-test.ps1 lo cargan automaticamente al arrancar.
# Nota: .env JAMAS se sube al repositorio (esta en .gitignore). Ningun secreto
#       tiene valor por defecto en el codigo: sin este archivo la API se niega
#       a atender peticiones protegidas.
# =============================================================================

# --- Llave de INGESTA del banco (solo POST /api/v1/transacciones y el
# --- simulador banco.html). Los endpoints de la app Android NO la usan:
# --- se autorizan con el ID token de Firebase (BIT-037); asi el APK ya no
# --- puede meter transacciones ni leer datos de otros clientes.
MIDFF_API_KEY=

# --- Oracle (esquema MIDFFuser creado por database/MIDFFuser.sql) ------------
MIDFF_DB_USUARIO=
MIDFF_DB_CLAVE=
MIDFF_DB_HOST=localhost
MIDFF_DB_PUERTO=1521
MIDFF_DB_SERVICIO=XEPDB1

# --- Consola MIDFF.html (firma HMAC de las sesiones de administrador) --------
MIDFF_ADMIN_SECRETO=

# --- Firebase -----------------------------------------------------------------
# Ruta del JSON de cuenta de servicio (FCM HTTP v1); p. ej. config/firebase.credentials.json
MIDFF_FCM_CUENTA_SERVICIO=
# Web API key del proyecto Firebase (esta en google-services.json: api_key[0])
# La usa la API para validar los ID token del cliente (accounts:lookup)
MIDFF_FIREBASE_WEB_KEY=

# --- Motor C (opcional; por defecto src/motor/bin/midff-scoring.exe) ----------
# MIDFF_MOTOR_EXE=
